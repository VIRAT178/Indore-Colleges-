# API base URL for split deployments.
# Leave blank when the frontend is served by the same Node server.
VITE_API_URL=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Obtain from Google AI Studio and keep it private.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MongoDB Atlas connection string.
MONGODB_URI=

# SMTP credentials for OTP and notification emails.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=
