# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB connection URI. Required on Render for durable user profiles and sessions.
MONGODB_URI=

# SMTP Email Configuration for OTP Verification (Optional: falls back to terminal logger & mock UI OTP if not configured)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=

# Google Maps Platform API Key
GOOGLE_MAPS_PLATFORM_KEY=

# Render API base URL used by the Vercel API proxy.
API_URL=https://indore-colleges-i560.onrender.com
